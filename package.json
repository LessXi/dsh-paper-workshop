{
  "name": "dsh-paper-workshop",
  "version": "0.1.0",
  "description": "论文研读工坊：5 个免 key 检索工具 + 7 阶段×教学循环统一 skill + 自管研读库（可切 Obsidian）+ 每周 arXiv 周报 + 网页面板。研读这篇→筛选→鸟瞰→精读(老师模式)→深挖→溯源→复现→内化。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "files": ["lib/index.js", "lib/client.js", "lib/types/**/*.d.ts", "SKILL.md", "cordis.patch.yml", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsdown && npm run build:types",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly --outDir lib/types",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.spec.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-agent-presets": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-web-react": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-host-apiproxy": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "repository": { "type": "git", "url": "https://github.com/LessXi/dsh-paper-workshop.git" }
}
